{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leco.ca/schemas/shadcn-ui/unscripted-ui-provenance.schema.json",
  "title": "ShadcnUI unscripted/ui provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "upstream", "adaptations", "excludedSiteMaterial"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "commit", "license", "licenseNoticeFile"],
      "properties": {
        "name": { "const": "unscripted/ui" },
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "const": "MIT" },
        "licenseNoticeFile": { "const": "THIRD_PARTY_NOTICES.md" }
      }
    },
    "adaptations": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "localPaths", "upstreamPaths", "localChanges"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "localPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "upstreamPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "localChanges": { "type": "string", "minLength": 1 }
        }
      }
    },
    "excludedSiteMaterial": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
