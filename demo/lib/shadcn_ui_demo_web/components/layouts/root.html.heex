<!DOCTYPE html>
<html lang="en" data-shadcn-theme={assigns[:theme] || "light"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || "ShadcnUI Gallery"}</title>
    <link rel="stylesheet" href={ShadcnUIDemoWeb.GalleryAssets.path("shadcn.css")} />
    <link rel="stylesheet" href={ShadcnUIDemoWeb.GalleryAssets.path("gallery.css")} />
    <script defer src={ShadcnUIDemoWeb.GalleryAssets.path("gallery.js")}></script>
  </head>
  <body class="gallery-shell">
    {@inner_content}
  </body>
</html>
