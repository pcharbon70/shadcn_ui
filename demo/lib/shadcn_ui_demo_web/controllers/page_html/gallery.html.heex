<Layouts.gallery
  page={@page}
  categories={@categories}
  components={@components}
  theme={@theme}
  motion={@motion}
>
  <p :if={@page.kind == :landing}>
    Transport-neutral Phoenix components with shadcn-style semantic tokens.
  </p>
  <nav :if={@page.kind == :landing} aria-label="Complete page examples">
    <a :for={composition <- ShadcnUIDemo.Catalogue.compositions()} href={composition.path}>
      {composition.label}
    </a>
  </nav>

  <p :if={@page.kind == :category && @page.slug == "foundation"}>
    Six foundational controls and content surfaces.
  </p>
  <p :if={@page.kind == :category && @page.slug == "forms"}>
    Fifteen native form primitives, controls, and measurement surfaces.
  </p>
  <nav :if={@page.kind == :category && @page.slug == "forms"} aria-label="Complete form examples">
    <a href="/forms/sign-in">Sign in composition</a>
    <a href="/forms/profile">Profile composition</a>
    <a href="/forms/settings">Settings composition</a>
  </nav>
  <p :if={@page.kind == :category && @page.slug == "disclosure"}>
    Native disclosure with independent and progressively exclusive grouping.
  </p>
  <p :if={@page.kind == :category && @page.slug == "navigation"}>
    Destination navigation and caller-heading-preserving header compositions.
  </p>
  <p :if={@page.kind == :category && @page.slug == "content-surfaces"}>
    Native scrolling, honest separation, and radio-based content selection.
  </p>
  <p :if={@page.kind == :category && @page.slug == "overlays"}>
    Native modal dialogs and nonmodal popovers with explicit ordinary alternatives.
  </p>
  <p :if={@page.kind == :category && @page.slug == "interactive-surfaces"}>
    Supplemental descriptions and link previews. Required information stays visible.
  </p>
  <div :if={@page.kind == :component} class="gallery-reference">
    <section>
      <h2>What it is</h2><p>{@page.reference.what}</p>
    </section>

    <section>
      <h2>When to use it</h2><p>{@page.reference.when}</p>
    </section>

    <section>
      <h2>Examples</h2><.component_examples render={@page.render} />
    </section>

    <section>
      <h2>Application responsibilities</h2><p>{@page.reference.responsibilities}</p>
    </section>

    <section>
      <h2>Accessibility</h2><p>{@page.reference.accessibility}</p>
    </section>
    <section>
      <h2>Native semantics and relationships</h2><p>{@page.reference.semantics}</p>
    </section>
    <section :if={Map.get(@page.reference, :comparison)}>
      <h2>Choosing the related control</h2><p>{@page.reference.comparison}</p>
    </section>
    <section>
      <h2>Themes</h2><p>
        Examples use package semantic tokens in explicit light and dark scopes.
      </p>
    </section>

    <section>
      <h2>Fallback</h2><p>{@page.reference.fallback}</p>
    </section>
    <section :if={Map.has_key?(@page.reference, :capability)}>
      <h2>Browser capabilities</h2><p>{@page.reference.capability}</p>
      <a href="/examples/overlay-capabilities">Inspect the locked browser capability matrix</a>
      <p>
        Native behavior and package CSS are distinct from demo-only theme and source-copy helpers.
      </p>
    </section>
    <section :if={Map.has_key?(@page.reference, :capability)} id="ordinary-alternative">
      <h2>Ordinary alternative: complete information and controls</h2>
      <p>
        Read the complete manual and review preferences here without opening a surface. No data is saved or deleted.
      </p>
      <p>
        Practical guidance, also available in the complete manual. Also available as plain text.
      </p>
      <p lang="ar" dir="rtl">معلومات إضافية متاحة أيضًا في الدليل الكامل.</p>
      <form id="sample-form">
        <label>Local display name <input name="display_name" value="Sample reader" /></label><button type="reset">Reset local example</button>
      </form>
      <p>
        Required help stays visible. A real application must provide its complete task here or at an ordinary route, not only inside an overlay.
      </p>
    </section>

    <section>
      <h2>Provenance</h2><p>
        Adapted from unscripted/ui commit <code>bd8f403</code> under its MIT notice.
      </p>
    </section>

    <section>
      <h2>HEEX source</h2>
      <button type="button" data-gallery-copy={"source-#{@page.slug}"}>Copy source</button>
      <span class="gallery-copy-status" aria-live="polite"></span> <pre
        id={"source-#{@page.slug}"}
        tabindex="0"
      ><code>{@page.reference.source}</code></pre>
    </section>
  </div>

  <.content_navigation_composition
    :if={
      @page.kind == :composition &&
        @page.render in [:documentation, :settings, :application_shell]
    }
    render={@page.render}
    selected={@page.selected}
    invalid={@page.invalid}
  />

  <.overlay_composition
    :if={
      @page.kind == :composition &&
        @page.render in [
          :overlay_capabilities,
          :settings_confirmation,
          :responsive_drawers,
          :anchored_actions,
          :supplemental_help
        ]
    }
    render={@page.render}
  />

  <.motion_media_capabilities :if={
    @page.kind == :composition && @page.render == :motion_media_capabilities
  } />

  <p :if={@page.kind == :not_found}>
    The requested gallery page does not exist. <a href="/">Return to the gallery.</a>
  </p>
</Layouts.gallery>
