<Layouts.gallery
  page={@page}
  categories={@categories}
  components={@components}
  theme={@theme}
  motion={@motion}
  build_identity={@build_identity}
>
  <p :if={@page.kind == :landing}>
    Transport-neutral Phoenix components with shadcn-style semantic tokens.
  </p>
  <nav :if={@page.kind == :landing} aria-label="Complete page examples">
    <a :for={composition <- ShadcnUIDemo.Catalogue.compositions()} href={composition.path}>
      {composition.label}
    </a>
  </nav>

  <p :if={@page.kind == :category && @page.slug == "foundation"}>
    Six foundational controls and content surfaces.
  </p>
  <p :if={@page.kind == :category && @page.slug == "forms"}>
    Fifteen native form primitives, controls, and measurement surfaces.
  </p>
  <nav :if={@page.kind == :category && @page.slug == "forms"} aria-label="Complete form examples">
    <a href="/forms/sign-in">Sign in composition</a>
    <a href="/forms/profile">Profile composition</a>
    <a href="/forms/settings">Settings composition</a>
  </nav>
  <p :if={@page.kind == :category && @page.slug == "disclosure"}>
    Native disclosure with independent and progressively exclusive grouping.
  </p>
  <p :if={@page.kind == :category && @page.slug == "navigation"}>
    Destination navigation and caller-heading-preserving header compositions.
  </p>
  <p :if={@page.kind == :category && @page.slug == "content-surfaces"}>
    Native scrolling, honest separation, and radio-based content selection.
  </p>
  <p :if={@page.kind == :category && @page.slug == "overlays"}>
    Native modal dialogs and nonmodal popovers with explicit ordinary alternatives.
  </p>
  <p :if={@page.kind == :category && @page.slug == "interactive-surfaces"}>
    Supplemental descriptions and link previews. Required information stays visible.
  </p>
  <p :if={@page.kind == :category && @page.slug == "motion"}>
    Complete static content with optional bounded decorative previews and entrance effects.
  </p>
  <div :if={@page.kind == :component} class="gallery-reference" data-gallery-component-article>
    <header class="gallery-reference__introduction">
      <p class="gallery-reference__description">
        {@page.documentation_entry.documentation.what}
      </p>
      <p class="gallery-reference__usage">
        <strong>When to use it.</strong> {@page.documentation_entry.documentation.when}
      </p>
      <div class="gallery-reference__capabilities" aria-label="Component capabilities">
        <.capability_badge
          :if={not @page.documentation_entry.presentation.status.migrated}
          id={"#{@page.slug}-native-baseline"}
          identity="native-baseline"
          label="Native baseline"
          description={@page.documentation_entry.documentation.native_baseline}
        />
        <.capability_badge
          :if={
            not @page.documentation_entry.presentation.status.migrated &&
              Map.has_key?(@page.reference, :capability)
          }
          id={"#{@page.slug}-progressive-enhancement"}
          identity="progressive-enhancement"
          label="Progressive enhancement"
          description={@page.documentation_entry.documentation.package_enhancement}
        />
        <.capability_badge
          :if={not @page.documentation_entry.presentation.status.migrated}
          id={"#{@page.slug}-fallback"}
          identity="fallback"
          label="Exact fallback"
          description={@page.documentation_entry.documentation.fallback}
        />
        <.capability_badge
          :for={
            capability <-
              if(@page.documentation_entry.presentation.status.migrated,
                do: @page.documentation_entry.presentation.features,
                else: []
              )
          }
          id={"#{@page.slug}-#{capability.identity}"}
          identity={capability.identity}
          label={capability.label}
          description={capability.description}
        />
      </div>
    </header>

    <section
      :for={example <- @page.documentation_entry.examples}
      id={example.fragment}
      class="gallery-example"
      tabindex="-1"
      data-gallery-example={example.source_id}
      data-gallery-example-layout={example.layout}
      data-gallery-theme-scope={@theme}
      data-gallery-motion-inspection={@motion}
    >
      <h2>{example.preview_label}</h2>
      <.specimen
        id={example.fragment}
        label={example.preview_label}
        source={example.source}
        source_id={example.source_id}
        theme={@theme}
        motion={@motion}
        layout={example.layout}
      >
        <:preview>
          <.component_examples render={@page.render} example_id={example.source_id} />
        </:preview>
        <:actions>
          <a href={"##{example.fragment}"}>Preview link</a>
          <a href={"##{example.source_fragment}"}>Code link</a>
        </:actions>
      </.specimen>
    </section>

    <section class="gallery-reference__guidance" data-gallery-how-it-works>
      <h2>How it works</h2>
      <ul :if={not @page.documentation_entry.presentation.status.migrated}>
        <li>
          <code>{"<.#{@page.documentation_entry.public.function}>"}</code>
          {@page.documentation_entry.documentation.native_baseline}
        </li>
        <li>
          <code>package CSS</code>
          {@page.documentation_entry.documentation.package_enhancement}
        </li>
        <li>
          <code>gallery only</code>
          {@page.documentation_entry.documentation.demo_behavior}
        </li>
        <li>
          <code>application boundary</code>
          {@page.documentation_entry.documentation.unsupported}
        </li>
      </ul>
      <ul :if={@page.documentation_entry.presentation.status.migrated}>
        <li :for={item <- @page.documentation_entry.presentation.how_it_works}>
          <code>{item.code}</code> {item.description}
        </li>
      </ul>
      <p>Examples use package semantic tokens in explicit light and dark scopes.</p>
    </section>

    <section class="gallery-reference__support" data-gallery-component-support>
      <h2>Accessibility and browser support</h2>
      <p>{@page.documentation_entry.documentation.accessibility}</p>
      <div :if={
        Map.has_key?(@page.reference, :capability) &&
          not @page.documentation_entry.presentation.status.migrated
      }>
        <.capability_badge
          id={"#{@page.slug}-authored-policy"}
          identity="authored-policy"
          label="Authored capability policy"
          description="This policy is authored from the closed catalogue and is not inferred from the current visitor."
        />
        <p>{@page.reference.capability}</p>
        <p>
          <a href="/examples/overlay-capabilities">Inspect the locked browser capability matrix</a>
        </p>
      </div>
      <.support_table
        :if={not @page.documentation_entry.presentation.status.migrated}
        label={"#{@page.label} support and fallback"}
        rows={[
          %{
            feature: "Native operation and optional package presentation",
            evidence: "Reviewed in the locked Chromium, Firefox, and WebKit evidence matrix.",
            fallback: @page.documentation_entry.documentation.fallback
          }
        ]}
      />
      <.support_table
        :if={@page.documentation_entry.presentation.status.migrated}
        label={"#{@page.label} support and fallback"}
        rows={@page.documentation_entry.presentation.support_rows}
      />
    </section>
    <section
      :if={
        Map.has_key?(@page.reference, :capability) &&
          @page.documentation_entry.category.slug in ["overlays", "interactive-surfaces"]
      }
      id="ordinary-alternative"
    >
      <h2>Ordinary alternative: complete information and controls</h2>
      <p>
        Read the complete manual and review preferences here without opening a surface. No data is saved or deleted.
      </p>
      <p>
        Practical guidance, also available in the complete manual. Also available as plain text.
      </p>
      <p lang="ar" dir="rtl">معلومات إضافية متاحة أيضًا في الدليل الكامل.</p>
      <form id="sample-form">
        <label>Local display name <input name="display_name" value="Sample reader" /></label><button type="reset">Reset local example</button>
      </form>
      <p>
        Required help stays visible. A real application must provide its complete task here or at an ordinary route, not only inside an overlay.
      </p>
    </section>

    <section class="gallery-reference__ownership" data-gallery-ownership>
      <h2>Application ownership and API</h2>
      <p>{@page.documentation_entry.documentation.responsibilities}</p>
      <p :if={Map.get(@page.reference, :api)}>
        <strong>Attributes and item slots.</strong> {@page.reference.api}
      </p>
      <p :if={Map.get(@page.reference, :comparison)}>
        <strong>Choosing the related control.</strong> {@page.reference.comparison}
      </p>
      <p>
        <a href={@page.documentation_entry.links.api}>Public API</a>
        <a href={@page.documentation_entry.links.source}>Package source</a>
      </p>
    </section>

    <nav aria-label="Related documentation">
      <h2>Related documentation</h2>
      <ul>
        <li :for={component <- @page.related.components}>
          <a href={component.path}>{component.label}</a>
        </li>
        <li :for={composition <- @page.related.compositions}>
          <a href={composition.path}>{composition.label} example</a>
        </li>
      </ul>
    </nav>

    <section class="gallery-reference__provenance" data-gallery-provenance>
      <h2>Provenance</h2><p>
        Catalogue identity <code>{@page.documentation_entry.provenance_id}</code>, adapted from
        unscripted/ui commit <code>{@build_identity.upstream_revision}</code>
        under its MIT notice.
      </p>
      <p>
        The documentation presentation is adapted locally; ShadcnUI's Phoenix API and native
        semantic contract remain authoritative.
      </p>
      <p :if={@page.documentation_entry.presentation.status.migrated}>
        {@page.documentation_entry.presentation.counterpart.local_changes}
      </p>
    </section>
  </div>

  <article
    :if={@page.kind == :composition}
    class="gallery-reference"
    data-gallery-composition-article={
      @page.presentation.status.migrated && @page.presentation.identity
    }
  >
    <header
      :if={@page.presentation.status.migrated}
      class="gallery-reference__introduction"
    >
      <p class="gallery-reference__description">{@page.presentation.description}</p>
      <div class="gallery-reference__capabilities" aria-label="Composition capabilities">
        <.capability_badge
          :for={feature <- @page.presentation.features}
          id={"#{@page.slug}-#{feature.identity}"}
          identity={feature.identity}
          label={feature.label}
          description={feature.description}
        />
      </div>
    </header>

    <section class="gallery-composition-body" data-gallery-composition-body>
      <.content_navigation_composition
        :if={@page.render in [:documentation, :settings, :application_shell]}
        render={@page.render}
        selected={@page.selected}
        invalid={@page.invalid}
      />

      <.presentation_fixture :if={@page.render == :documentation} />

      <.overlay_composition
        :if={
          @page.render in [
            :overlay_capabilities,
            :settings_confirmation,
            :responsive_drawers,
            :anchored_actions,
            :supplemental_help
          ]
        }
        render={@page.render}
      />

      <.motion_media_capabilities :if={@page.render == :motion_media_capabilities} />

      <ShadcnUIDemoWeb.MediaExamples.media_browser :if={@page.render == :media_browser} />
      <ShadcnUIDemoWeb.ImageGalleryExamples.composition :if={@page.render == :image_gallery} />

      <ShadcnUIDemoWeb.MotionExamples.motion_preferences
        :if={@page.render == :motion_preferences}
        theme={@theme}
      />
    </section>

    <section :if={@page.presentation.status.migrated} data-gallery-component-support>
      <h2>Support and exact fallback</h2>
      <.support_table
        label={"#{@page.label} support and fallback"}
        rows={@page.presentation.support_rows}
      />
      <p>{@page.presentation.exact_fallback}</p>
    </section>
  </article>

  <p :if={@page.kind == :not_found}>
    The requested gallery page does not exist. <a href="/">Return to the gallery.</a>
  </p>
</Layouts.gallery>
