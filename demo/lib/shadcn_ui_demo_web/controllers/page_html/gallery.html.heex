<Layouts.gallery
  page={@page}
  category={@category}
  components={@components}
  theme={@theme}
>
  <p :if={@page.kind == :landing}>
    Transport-neutral Phoenix components with shadcn-style semantic tokens.
  </p>
  <p :if={@page.kind == :category}>
    Six foundational controls and content surfaces.
  </p>
  <p :if={@page.kind == :component}>
    Public HEEX examples and caller ownership guidance for {@page.label}.
  </p>
  <p :if={@page.kind == :not_found}>
    The requested gallery page does not exist. <a href="/">Return to the gallery.</a>
  </p>
</Layouts.gallery>
