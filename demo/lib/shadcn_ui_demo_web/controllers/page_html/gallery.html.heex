<Layouts.gallery
  page={@page}
  categories={@categories}
  components={@components}
  theme={@theme}
  motion={@motion}
  build_identity={@build_identity}
>
  <p :if={@page.kind == :landing}>
    Transport-neutral Phoenix components with shadcn-style semantic tokens.
  </p>
  <nav :if={@page.kind == :landing} aria-label="Complete page examples">
    <a :for={composition <- ShadcnUIDemo.Catalogue.compositions()} href={composition.path}>
      {composition.label}
    </a>
  </nav>

  <p :if={@page.kind == :category && @page.slug == "foundation"}>
    Six foundational controls and content surfaces.
  </p>
  <p :if={@page.kind == :category && @page.slug == "forms"}>
    Fifteen native form primitives, controls, and measurement surfaces.
  </p>
  <nav :if={@page.kind == :category && @page.slug == "forms"} aria-label="Complete form examples">
    <a href="/forms/sign-in">Sign in composition</a>
    <a href="/forms/profile">Profile composition</a>
    <a href="/forms/settings">Settings composition</a>
  </nav>
  <p :if={@page.kind == :category && @page.slug == "disclosure"}>
    Native disclosure with independent and progressively exclusive grouping.
  </p>
  <p :if={@page.kind == :category && @page.slug == "navigation"}>
    Destination navigation and caller-heading-preserving header compositions.
  </p>
  <p :if={@page.kind == :category && @page.slug == "content-surfaces"}>
    Native scrolling, honest separation, and radio-based content selection.
  </p>
  <p :if={@page.kind == :category && @page.slug == "overlays"}>
    Native modal dialogs and nonmodal popovers with explicit ordinary alternatives.
  </p>
  <p :if={@page.kind == :category && @page.slug == "interactive-surfaces"}>
    Supplemental descriptions and link previews. Required information stays visible.
  </p>
  <p :if={@page.kind == :category && @page.slug == "motion"}>
    Complete static content with optional bounded decorative previews and entrance effects.
  </p>
  <div :if={@page.kind == :component} class="gallery-reference">
    <section>
      <h2>What it is</h2><p>{@page.documentation_entry.documentation.what}</p>
    </section>

    <section>
      <h2>When to use it</h2><p>{@page.documentation_entry.documentation.when}</p>
    </section>

    <section
      id={hd(@page.documentation_entry.examples).fragment}
      class="gallery-example"
      data-gallery-example={hd(@page.documentation_entry.examples).source_id}
      data-gallery-theme-scope={@theme}
      data-gallery-motion-inspection={@motion}
    >
      <h2>{hd(@page.documentation_entry.examples).preview_label}</h2>
      <p>
        <a href={"##{hd(@page.documentation_entry.examples).fragment}"}>Link to this example</a>
      </p>
      <div class="gallery-example-preview">
        <.component_examples render={@page.render} />
      </div>
    </section>

    <section>
      <h2>Application responsibilities</h2><p>
        {@page.documentation_entry.documentation.responsibilities}
      </p>
    </section>
    <section :if={Map.get(@page.reference, :api)}>
      <h2>Attributes and item slots</h2><p>{@page.reference.api}</p>
    </section>

    <section>
      <h2>Accessibility</h2><p>{@page.documentation_entry.documentation.accessibility}</p>
    </section>
    <section>
      <h2>Native baseline</h2><p>
        {@page.documentation_entry.documentation.native_baseline}
      </p>
    </section>
    <section>
      <h2>Package CSS enhancement</h2><p>
        {@page.documentation_entry.documentation.package_enhancement}
      </p>
    </section>
    <section>
      <h2>Gallery-only behavior</h2><p>
        {@page.documentation_entry.documentation.demo_behavior}
      </p>
    </section>
    <section>
      <h2>Not provided by this component</h2><p>
        {@page.documentation_entry.documentation.unsupported}
      </p>
    </section>
    <section :if={Map.get(@page.reference, :comparison)}>
      <h2>Choosing the related control</h2><p>{@page.reference.comparison}</p>
    </section>
    <section>
      <h2>Themes</h2><p>
        Examples use package semantic tokens in explicit light and dark scopes.
      </p>
    </section>

    <section>
      <h2>Fallback</h2><p>{@page.documentation_entry.documentation.fallback}</p>
    </section>
    <section :if={Map.has_key?(@page.reference, :capability)}>
      <h2>Browser capabilities</h2><p>{@page.reference.capability}</p>
      <a href="/examples/overlay-capabilities">Inspect the locked browser capability matrix</a>
      <p>
        Native behavior and package CSS are distinct from demo-only theme and source-copy helpers.
      </p>
    </section>
    <section :if={Map.has_key?(@page.reference, :capability)} id="ordinary-alternative">
      <h2>Ordinary alternative: complete information and controls</h2>
      <p>
        Read the complete manual and review preferences here without opening a surface. No data is saved or deleted.
      </p>
      <p>
        Practical guidance, also available in the complete manual. Also available as plain text.
      </p>
      <p lang="ar" dir="rtl">معلومات إضافية متاحة أيضًا في الدليل الكامل.</p>
      <form id="sample-form">
        <label>Local display name <input name="display_name" value="Sample reader" /></label><button type="reset">Reset local example</button>
      </form>
      <p>
        Required help stays visible. A real application must provide its complete task here or at an ordinary route, not only inside an overlay.
      </p>
    </section>

    <section>
      <h2>Provenance</h2><p>
        Catalogue identity <code>{@page.documentation_entry.provenance_id}</code>, adapted from
        unscripted/ui commit <code>{@build_identity.upstream_revision}</code>
        under its MIT notice.
      </p>
      <p>
        <a href={@page.documentation_entry.links.api}>Public API</a>
        <a href={@page.documentation_entry.links.source}>Package source</a>
      </p>
    </section>

    <nav aria-label="Related documentation">
      <h2>Related documentation</h2>
      <ul>
        <li :for={component <- @page.related.components}>
          <a href={component.path}>{component.label}</a>
        </li>
        <li :for={composition <- @page.related.compositions}>
          <a href={composition.path}>{composition.label} example</a>
        </li>
      </ul>
    </nav>

    <section
      id={"#{hd(@page.documentation_entry.examples).fragment}-source"}
      data-gallery-example-source={hd(@page.documentation_entry.examples).source_id}
    >
      <h2>HEEX source</h2>
      <button
        type="button"
        data-gallery-copy={"source-#{@page.slug}"}
        aria-describedby={"source-#{@page.slug}-status"}
      >Copy source</button>
      <span
        id={"source-#{@page.slug}-status"}
        class="gallery-copy-status"
        aria-live="polite"
      ></span> <pre
        id={"source-#{@page.slug}"}
        tabindex="0"
      ><code>{@page.documentation_entry.documentation.source}</code></pre>
    </section>
  </div>

  <.content_navigation_composition
    :if={
      @page.kind == :composition &&
        @page.render in [:documentation, :settings, :application_shell]
    }
    render={@page.render}
    selected={@page.selected}
    invalid={@page.invalid}
  />

  <.overlay_composition
    :if={
      @page.kind == :composition &&
        @page.render in [
          :overlay_capabilities,
          :settings_confirmation,
          :responsive_drawers,
          :anchored_actions,
          :supplemental_help
        ]
    }
    render={@page.render}
  />

  <.motion_media_capabilities :if={
    @page.kind == :composition && @page.render == :motion_media_capabilities
  } />

  <ShadcnUIDemoWeb.MediaExamples.media_browser :if={
    @page.kind == :composition && @page.render == :media_browser
  } />
  <ShadcnUIDemoWeb.ImageGalleryExamples.composition :if={
    @page.kind == :composition && @page.render == :image_gallery
  } />

  <ShadcnUIDemoWeb.MotionExamples.motion_preferences
    :if={@page.kind == :composition && @page.render == :motion_preferences}
    theme={@theme}
  />

  <p :if={@page.kind == :not_found}>
    The requested gallery page does not exist. <a href="/">Return to the gallery.</a>
  </p>
</Layouts.gallery>
