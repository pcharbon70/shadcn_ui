<main class="gallery-standalone" data-shadcn-theme="light">
  <h1>Received demonstration values</h1>
  <p>No authentication, persistence, authorization, or domain operation was performed.</p>
  <dl data-demo-received-values>
    <div :for={{key, value} <- @values}>
      <dt>{key}</dt>
      <dd :if={is_list(value)}><span :for={item <- value}>{item}</span></dd>
      <dd :if={!is_list(value)}>{value}</dd>
    </div>
  </dl>
  <a href="/components/forms">Return to Forms</a>
</main>
