{
  "name": "@leco/shadcn-ui-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Pinned build tooling for the ShadcnUI compiled stylesheet.",
  "scripts": {
    "assets:build": "node ./scripts/build-assets.mjs",
    "assets:check": "node ./scripts/check-assets.mjs",
    "browser:accordion": "node ./demo/node_modules/@playwright/test/cli.js test --config ./playwright.accordion.config.mjs",
    "browser:navigation": "node ./demo/node_modules/@playwright/test/cli.js test --config ./playwright.navigation.config.mjs",
    "browser:phase4": "node ./demo/node_modules/@playwright/test/cli.js test --config ./playwright.phase4.config.mjs",
    "browser:milestone-c": "npm --prefix demo run browser:milestone-c",
    "browser:milestone-d-phase1": "node ./demo/node_modules/@playwright/test/cli.js test --config ./playwright.milestone-d-phase1.config.mjs",
    "browser:milestone-d-phase2": "node ./demo/node_modules/@playwright/test/cli.js test --config ./playwright.milestone-d-phase2.config.mjs",
    "browser:milestone-d-phase3": "node ./demo/node_modules/@playwright/test/cli.js test --config ./playwright.milestone-d-phase3.config.mjs",
    "browser:milestone-d-phase4": "node ./demo/node_modules/@playwright/test/cli.js test --config ./playwright.milestone-d-phase4.config.mjs",
    "browser:milestone-d-phase5": "node ./demo/node_modules/@playwright/test/cli.js test --config ./playwright.milestone-d-phase5.config.mjs",
    "browser:milestone-d-gallery": "node ./demo/node_modules/@playwright/test/cli.js test --config ./playwright.milestone-d-gallery.config.mjs",
    "gallery:smoke": "npm --prefix demo run export:determinism"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
